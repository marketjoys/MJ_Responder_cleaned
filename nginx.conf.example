# Nginx Configuration for Email Automation App
# File: /etc/nginx/sites-available/marketautomailer
# 
# After creating this file, enable it with:
# sudo ln -s /etc/nginx/sites-available/marketautomailer /etc/nginx/sites-enabled/
# sudo nginx -t
# sudo systemctl restart nginx

server {
    listen 80;
    server_name marketautomailer.mj.publicvm.com;
    
    # Increase client max body size for file uploads
    client_max_body_size 50M;
    
    # Logging
    access_log /var/log/nginx/marketautomailer-access.log;
    error_log /var/log/nginx/marketautomailer-error.log;
    
    # Frontend - Serve static React build files
    location / {
        root /var/www/html/marketautomailer;
        index index.html index.htm;
        
        # React Router support - always serve index.html for client-side routing
        try_files $uri $uri/ /index.html;
        
        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        
        # Don't cache index.html
        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }
    
    # Backend API - Proxy to FastAPI on port 9000
    location /api/ {
        # Proxy pass to backend
        proxy_pass http://localhost:9000/api/;
        
        # Proxy headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts for long-running requests
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # CORS headers (optional, backend already handles this)
        add_header 'Access-Control-Allow-Origin' 'http://marketautomailer.mj.publicvm.com' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        
        # Handle preflight OPTIONS requests
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' 'http://marketautomailer.mj.publicvm.com' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }
    }
    
    # OAuth callback routes - also proxy to backend
    location /oauth/ {
        proxy_pass http://localhost:9000/oauth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

