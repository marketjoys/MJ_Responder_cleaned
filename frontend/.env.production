# Frontend Environment Configuration for Production Deployment

# Backend API URL - Update this based on your deployment
# For local deployment with backend on port 9000:
REACT_APP_BACKEND_URL=http://localhost:9000/api

# For deployment to marketautomailer.mj.publicvm.com:
# REACT_APP_BACKEND_URL=http://marketautomailer.mj.publicvm.com:9000/api

# Or if using Nginx/Apache proxy:
# REACT_APP_BACKEND_URL=http://marketautomailer.mj.publicvm.com/api
